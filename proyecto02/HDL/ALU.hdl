CHIP ALU {
    IN
        x[16], y[16],
        zx, nx, zy, ny, f, no;

    OUT
        out[16],
        zr,
        ng;

    PARTS:

    Mux16(a=x, b=false, sel=zx, out=x0);
    Not16(in=x0, out=x1);
    Mux16(a=x0, b=x1, sel=nx, out=xFinal);

    Mux16(a=y, b=false, sel=zy, out=y0);
    Not16(in=y0, out=y1);
    Mux16(a=y0, b=y1, sel=ny, out=yFinal);

    And16(a=xFinal, b=yFinal, out=andResult);
    Add16(a=xFinal, b=yFinal, out=addResult);
    Mux16(a=andResult, b=addResult, sel=f, out=result);

    Not16(in=result, out=resultNot);

    Mux16(
        a=result,
        b=resultNot,
        sel=no,
        out=out,
        out[0..7]=low,
        out[8..15]=high,
        out[15]=ng
    );

    Or8Way(in=low, out=lowOr);
    Or8Way(in=high, out=highOr);
    Or(a=lowOr, b=highOr, out=anyBit);
    Not(in=anyBit, out=zr);
}